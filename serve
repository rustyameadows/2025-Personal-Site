#!/bin/zsh

set -euo pipefail

PORT="${1:-4000}"

if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  echo "Usage: ./serve [port]"
  echo "Port must be a number."
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

cd "$SCRIPT_DIR"

echo "Serving /Users/rustymeadows/dev/2025-Personal-Site at http://localhost:${PORT}/"
echo "Press Ctrl-C to stop."

exec python3 -m http.server "$PORT"
